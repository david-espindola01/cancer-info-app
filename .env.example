# Copia este archivo como .env.local y completa los valores.
# En Vercel, estas variables se configuran en Settings → Environment Variables.

# Proveedor de LLM: "groq" en uso real, "falso" en pruebas y CI (no gasta cuota).
LLM_PROVEEDOR=groq

# Groq (https://console.groq.com/keys). Cada agente usa un modelo distinto
# porque los límites de la capa gratuita son por modelo (8.000 tokens/minuto).
GROQ_API_KEY=
# El Lector interpreta ciencia: el modelo grande es más fiel (colon vs. recto,
# asociación vs. causa). Se usa una sola vez por artículo.
GROQ_MODELO_LECTOR=openai/gpt-oss-120b
# El Presentador arma páginas a partir de memorias ya curadas: el modelo pequeño es
# rápido (~1,5 s) y conserva una cuota separada de la del Lector.
GROQ_MODELO_PRESENTADOR=openai/gpt-oss-20b
# "low" gasta ~70 % menos tokens de salida que "medium" con resultados equivalentes.
GROQ_ESFUERZO_RAZONAMIENTO=low

# Postgres (Neon). Usa la cadena de conexión "pooled".
DATABASE_URL=

# Acceso a la página /subir.
ADMIN_CLAVE=
# Secreto para firmar la cookie de sesión (mínimo 32 caracteres aleatorios).
SESION_SECRETO=
