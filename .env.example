# Copy this file as .env.local and fill in the values.
# On Vercel, these variables are set in Settings → Environment Variables.

# LLM provider: "groq" in real use, "fake" in tests and CI (spends no quota).
LLM_PROVIDER=groq

# Groq (https://console.groq.com/keys). Each agent uses a different model because the
# free tier's limits are per model (8,000 tokens/minute).
GROQ_API_KEY=
# The Reader interprets science: the big model is more faithful (colon vs. rectum,
# association vs. cause). It is used only once per article.
GROQ_READER_MODEL=openai/gpt-oss-120b
# The Presenter builds pages from already curated memories: the small model is fast
# (~1.5 s) and keeps a quota separate from the Reader's.
GROQ_PRESENTER_MODEL=openai/gpt-oss-20b
# If the Presenter's model hits its daily limit, a visitor waiting for a page is served
# with this one (it has its own quota). Prefetching never uses it.
GROQ_PRESENTER_FALLBACK_MODEL=openai/gpt-oss-120b
# "low" spends ~70 % fewer output tokens than "medium" with equivalent results.
GROQ_REASONING_EFFORT=low

# Prefetching: after each visit up to PREFETCH_PER_VISIT next pages are prepared, without
# going over PREFETCH_DAILY_MAX per day (the rest of Groq's daily quota is left for real visits).
PREFETCH_PER_VISIT=2
PREFETCH_DAILY_MAX=30

# Postgres (Neon). Use the "pooled" connection string.
DATABASE_URL=
# Database used only by the integration and e2e tests: it is wiped on every run.
TEST_DATABASE_URL=

# Access to the /upload page.
ADMIN_PASSWORD=
# Secret to sign the session cookie (at least 32 random characters).
SESSION_SECRET=
