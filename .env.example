# Copia este archivo como .env.local y completa los valores.
# En Vercel, estas variables se configuran en Settings → Environment Variables.

# Proveedor de LLM: "groq" en uso real, "falso" en pruebas y CI (no gasta cuota).
LLM_PROVEEDOR=groq

# Groq (https://console.groq.com/keys). Cada agente usa un modelo distinto
# porque los límites de la capa gratuita son por modelo.
GROQ_API_KEY=
GROQ_MODELO_LECTOR=openai/gpt-oss-20b
GROQ_MODELO_PRESENTADOR=openai/gpt-oss-120b

# Postgres (Neon). Usa la cadena de conexión "pooled".
DATABASE_URL=

# Acceso a la página /subir.
ADMIN_CLAVE=
# Secreto para firmar la cookie de sesión (mínimo 32 caracteres aleatorios).
SESION_SECRETO=
