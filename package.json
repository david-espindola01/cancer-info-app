{
  "name": "cancer-info-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:cobertura": "vitest run --coverage",
    "e2e": "playwright test",
    "knip": "knip",
    "duplicados": "jscpd",
    "dependencias": "depcruise src --config .dependency-cruiser.cjs",
    "verificar": "npm run lint && npm run typecheck && npm run knip && npm run duplicados && npm run dependencias && npm run test:cobertura && npm run build"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^4.1.11",
    "dependency-cruiser": "^17.4.3",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "jscpd": "^5.4.2",
    "jsdom": "^29.1.1",
    "knip": "^6.42.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24"
  }
}
